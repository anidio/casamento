# Connection string do Neon (Dashboard > Connect > Connection string). Use a versão "pooled".
DATABASE_URL=postgresql://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Login (Better Auth)
# Gere um segredo com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=troque-por-um-segredo-aleatorio
# Endereço do site. Em produção, o domínio real (ex.: https://juntos.com.br)
BETTER_AUTH_URL=http://localhost:3000

# E-mails (opcional em desenvolvimento: sem a chave, o link de "esqueci a senha" aparece no terminal)
RESEND_API_KEY=
EMAIL_FROM=Juntos <onboarding@resend.dev>
